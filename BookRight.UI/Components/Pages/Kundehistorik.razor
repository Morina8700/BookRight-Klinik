@page "/kundehistorik"
@rendermode InteractiveServer
@using BookRight.Facade.Contracts.Bookinger
@using BookRight.Facade.Contracts.Kunder
@using BookRight.Facade.Interfaces
@inject IBookingFacade BookingFacade

<main class="opret-booking-side">
    <article class="opret-booking-kort" aria-labelledby="kundehistorik-heading">
        <header class="opret-booking-header">
            <p class="brand" aria-label="BookRight">BookRight</p>
            <h1 id="kundehistorik-heading">Kundehistorik</h1>
        </header>

        @if (isLoading)
        {
            <p>Indlæser data...</p>
        }
        else
        {
            <div class="opret-booking-form">
                <div class="formular-sektion">
                    <div class="formular-felt">
                        <label for="kunde">Kunde</label>
                        <select id="kunde" @onchange="OnKundeValgt">
                            <option value="">-- Vælg kunde --</option>
                            @foreach (var kunde in alleKunder)
                            {
                                <option value="@kunde.KundeId">@kunde.FuldeNavn</option>
                            }
                        </select>
                    </div>
                </div>

                @if (valgtKundeId != Guid.Empty)
                {
                    @if (historikPoster.Count == 0)
                    {
                        <p>Ingen historik fundet for den valgte kunde.</p>
                    }
                    else
                    {
                        <div class="formular-sektion">
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th>Start</th>
                                        <th>Slut</th>
                                        <th>Klinik</th>
                                        <th>Behandler</th>
                                        <th>Behandlingstype</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var post in historikPoster)
                                    {
                                        <tr>
                                            <td>@post.StartTid.ToString("dd-MM-yyyy HH:mm")</td>
                                            <td>@post.SlutTid.ToString("dd-MM-yyyy HH:mm")</td>
                                            <td>@post.KlinikNavn</td>
                                            <td>@post.BehandlerNavn</td>
                                            <td>@post.BehandlingstypeNavn</td>
                                            <td>@post.Status</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
            </div>
        }
    </article>
</main>

@code {
    private List<KundeDto> alleKunder = new();
    private List<KundehistorikDto> historikPoster = new();
    private Guid valgtKundeId = Guid.Empty;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        alleKunder = (await BookingFacade.HentAlleKunderAsync()).ToList();
        isLoading = false;
    }

    private async Task OnKundeValgt(ChangeEventArgs e)
    {
        if (!Guid.TryParse(e.Value?.ToString(), out var kundeId))
        {
            valgtKundeId = Guid.Empty;
            historikPoster = new();
            return;
        }

        valgtKundeId = kundeId;
        historikPoster = (await BookingFacade.HentKundehistorikAsync(valgtKundeId)).ToList();
    }
}
