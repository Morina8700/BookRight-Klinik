@page "/kundehistorik"
@rendermode InteractiveServer
@using BookRight.Facade.Contracts.Bookinger
@using BookRight.Facade.Contracts.Kunder
@using BookRight.Facade.Interfaces
@using BookRight.Domain.Interfaces
@inject IBookingFacade BookingFacade
@inject IKundeRepository KundeRepository

<main class="opret-booking-side">
    <article class="opret-booking-kort" aria-labelledby="kundehistorik-heading">
        <header class="opret-booking-header">
            <p class="brand" aria-label="BookRight">BookRight</p>
            <h1 id="kundehistorik-heading">Kundehistorik</h1>
        </header>

        @if (isLoading)
        {
            <p>Indlæser data...</p>
        }
        else
        {
            <div class="opret-booking-form">
                <div class="formular-sektion">
                    <div class="formular-felt">
                        <label for="kunde">Kunde</label>
                        <select id="kunde" @onchange="OnKundeValgt">
                            <option value="">-- Vælg kunde --</option>
                            @foreach (var kunde in alleKunder)
                            {
                                <option value="@kunde.KundeId">@kunde.FuldeNavn</option>
                            }
                        </select>
                    </div>
                </div>

                @if (valgtKundeId != Guid.Empty)
                {
                    <p>Kundehistorik er ikke implementeret endnu.</p>
                }
            </div>
        }
    </article>
</main>

@code {
    private List<KundeDto> alleKunder = new();
    private Guid valgtKundeId = Guid.Empty;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        var kunder = await KundeRepository.HentAlleAsync();

        alleKunder = kunder.Select(k => new KundeDto
        {
            KundeId = k.KundeId,
            FuldeNavn = $"{k.Fornavn} {k.Efternavn}",
            Email = k.Email,
            Telefon = k.Telefon,
            LoyalitetsNiveau = k.loyalitetsNiveau.ToString()
        }).ToList();

        isLoading = false;
    }

    private void OnKundeValgt(ChangeEventArgs e)
    {
        if (!Guid.TryParse(e.Value?.ToString(), out var kundeId))
        {
            valgtKundeId = Guid.Empty;
            return;
        }

        valgtKundeId = kundeId;
    }
}
