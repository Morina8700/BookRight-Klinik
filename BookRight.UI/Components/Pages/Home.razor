@page "/"

<PageTitle>BookRight Dashboard</PageTitle>

<main class="home-dashboard">
    <BookRightTopNav />

    <section class="welcome-panel" aria-labelledby="welcome-heading">
        <h2 id="welcome-heading">Velkommen til BookRight</h2>
        <p>Oversigt over din klinik</p>
    </section>

    <section class="metric-grid" aria-label="Nøgletal">
        <article class="metric-card">
            <p>Aktive kunder</p>
            <strong>127</strong>
        </article>

        <article class="metric-card">
            <p>Bookinger i dag</p>
            <strong>8</strong>
        </article>

        <article class="metric-card">
            <p>Bookinger denne uge</p>
            <strong>45</strong>
        </article>

        <article class="metric-card">
            <p>Afsluttede behandlinger</p>
            <strong>892</strong>
        </article>
    </section>

    <section class="appointments-panel" aria-labelledby="appointments-heading">
        <h2 id="appointments-heading">Kommende aftaler i dag</h2>

        <div class="appointment-list">
            <article class="appointment-item">
                <div>
                    <span>Dato &amp; Tid</span>
                    <time datetime="2026-05-21T10:00">21-05-2026</time>
                    <p>10.00 - 11.00</p>
                </div>

                <div>
                    <span>Behandling</span>
                    <strong>Massage</strong>
                    <p>Sarah Andersen</p>
                </div>

                <div>
                    <span>Klinik</span>
                    <strong>BookRight Egtved</strong>
                </div>
            </article>

            <article class="appointment-item">
                <div>
                    <span>Dato &amp; Tid</span>
                    <time datetime="2026-05-21T14:30">21-05-2026</time>
                    <p>14.30 - 15.30</p>
                </div>

                <div>
                    <span>Behandling</span>
                    <strong>Fysioterapi</strong>
                    <p>Casper Madsen</p>
                </div>

                <div>
                    <span>Klinik</span>
                    <strong>BookRight Egtved</strong>
                </div>
            </article>
        </div>
    </section>

    <section class="quick-actions" aria-label="Hurtige handlinger">
        <article class="quick-action quick-action--booking">
            <h2>Hurtig booking</h2>
            <p>Opret en ny booking til en kunde</p>
            <NavLink class="quick-action__link" href="opret-booking">Opret booking</NavLink>
        </article>

        <article class="quick-action quick-action--customer">
            <h2>Ny kunde</h2>
            <p>Tilføj en ny kunde til systemet</p>
            <NavLink class="quick-action__link" href="kunder/opret">Opret kunde</NavLink>
        </article>
    </section>
</main>

<style>
    .home-dashboard {
        max-width: 980px;
        margin: 0 auto;
        padding: 1.75rem;
        color: #1f2937;
    }

    .welcome-panel,
    .appointments-panel {
        padding: 2rem;
        border-radius: 8px;
        background: #ffffff;
        box-shadow: 0 16px 32px rgba(31, 41, 55, 0.12);
    }

    .welcome-panel {
        margin-bottom: 1.75rem;
    }

    .welcome-panel h2,
    .appointments-panel h2,
    .quick-action h2 {
        margin: 0 0 0.65rem;
        color: #2c287f;
        font-size: 1.55rem;
        font-weight: 800;
    }

    .welcome-panel p,
    .quick-action p {
        margin: 0;
    }

    .metric-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1.5rem;
        margin-bottom: 1.75rem;
    }

    .metric-card {
        min-height: 9rem;
        padding: 1.5rem;
        border-radius: 8px;
        background: #ffffff;
        box-shadow: 0 16px 32px rgba(31, 41, 55, 0.12);
    }

    .metric-card p {
        margin: 0 0 0.9rem;
        line-height: 1.45;
    }

    .metric-card strong {
        color: #2c287f;
        font-size: 2rem;
        line-height: 1;
    }

    .appointments-panel {
        margin-bottom: 1.75rem;
    }

    .appointment-list {
        display: grid;
        gap: 1rem;
        margin-top: 1.5rem;
    }

    .appointment-item {
        display: grid;
        grid-template-columns: 1fr 1.15fr 1.15fr;
        gap: 1.5rem;
        padding: 1.25rem;
        border-left: 4px solid #4f46e5;
        border-radius: 0 8px 8px 0;
        background: #eef2ff;
    }

    .appointment-item span {
        display: block;
        margin-bottom: 0.35rem;
        color: #4b5563;
    }

    .appointment-item time,
    .appointment-item strong {
        display: block;
        color: #111827;
        font-weight: 800;
    }

    .appointment-item p {
        margin: 0.25rem 0 0;
        color: #4338ca;
    }

    .quick-actions {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.75rem;
    }

    .quick-action {
        padding: 2rem;
        border-radius: 8px;
        color: #ffffff;
        box-shadow: 0 16px 32px rgba(31, 41, 55, 0.18);
    }

    .quick-action h2,
    .quick-action p {
        color: #ffffff;
    }

    .quick-action--booking {
        background: linear-gradient(135deg, #4f46e5, #312e81);
    }

    .quick-action--customer {
        background: linear-gradient(135deg, #7c3aed, #6d28d9);
    }

    .quick-action__link {
        display: inline-block;
        margin-top: 1.8rem;
        padding: 0.8rem 1.4rem;
        border-radius: 8px;
        background: #ffffff;
        color: #4338ca;
        text-decoration: none;
        font-weight: 800;
    }

    @@media (max-width: 900px) {
        .metric-grid,
        .quick-actions {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .appointment-item {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 640px) {
        .home-dashboard {
            padding: 1rem;
        }

        .metric-grid,
        .quick-actions {
            width: 100%;
        }

        .metric-grid,
        .quick-actions {
            grid-template-columns: 1fr;
        }
    }
</style>
